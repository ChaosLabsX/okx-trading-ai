# OKX signal checker - VPS environment. Copy to `.env` in the repo root
# (C:\OKXAI\.env) and fill in your real values. Never commit .env - it is
# gitignored.
#
# This file is the canonical list of everything the worker needs. run-okx.ps1
# loads it into the process environment before launching signal_checker.py,
# which reads os.environ directly - so a variable missing here is a variable the
# worker will never see.

# Telegram (the OKX bot - NOT the Forex one)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OKX API (the account this bot trades)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Supabase (the OKX project - NOT the Forex one)
SUPABASE_URL=
SUPABASE_KEY=

# Anthropic - Claude trade advisor (the model itself is set in signal_checker.py).
# Optional: auto-trade sizing is skipped if unset, the rest of the worker still runs.
CLAUDE_API_KEY=
